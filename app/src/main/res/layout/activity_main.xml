<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <cn.lancet.navigation.widget.PillClipFrameLayout
        android:id="@+id/bottom_navigation_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/ios26_bottom_tab_height"
        android:layout_marginStart="@dimen/ios26_bottom_tab_margin_horizontal"
        android:layout_marginEnd="@dimen/ios26_bottom_tab_margin_horizontal"
        android:layout_marginBottom="@dimen/ios26_bottom_tab_margin_bottom"
        android:background="@drawable/bg_bottom_glass_container"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:elevation="@dimen/ios26_bottom_tab_elevation"
        android:translationZ="@dimen/ios26_bottom_tab_elevation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/bottom_navigation_blur_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clipChildren="true"
            android:clipToPadding="true">

            <LinearLayout
                android:id="@+id/ll_bottom_tabs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <LinearLayout
                    android:id="@+id/tab_home"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center">

                    <LinearLayout
                        android:id="@+id/tab_home_content"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_bottom_tab_selected"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="32dp"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/iv_tab_home"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_menu_home"
                                app:tint="#006D77" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_home_badge"
                                android:layout_width="32dp"
                                android:layout_height="18dp"
                                android:layout_gravity="top|end"
                                android:layout_marginTop="-5dp"
                                android:layout_marginEnd="-9dp"
                                android:background="@drawable/bg_bottom_tab_badge"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="99+"
                                android:textColor="@android:color/white"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                tools:visibility="visible" />

                        </FrameLayout>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_tab_home"
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:layout_marginTop="1dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/home"
                            android:textColor="#006D77"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <Space
                    android:layout_width="14dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/tab_me"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center">

                    <LinearLayout
                        android:id="@+id/tab_me_content"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_tab_me"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_menu_me"
                            app:tint="#7A7F83" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_tab_me"
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:layout_marginTop="1dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/me"
                            android:textColor="#7A7F83"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </eightbitlab.com.blurview.BlurView>

    </cn.lancet.navigation.widget.PillClipFrameLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_create_notice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:elevation="5dp"
        android:importantForAccessibility="no"
        android:src="@drawable/icon_camera"
        app:backgroundTint="@color/light_blue_A200"
        app:fabSize="auto"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation_container"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>